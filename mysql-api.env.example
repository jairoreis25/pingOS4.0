# ============================================================================
# PingOS — variáveis de ambiente do backend MySQL (API paralela ao Convex)
# ============================================================================
# Copie este arquivo para `mysql-api.env` na raiz do projeto e preencha os
# valores. O arquivo `mysql-api.env` é lido automaticamente pelo servidor
# (server/api/env.ts) e NÃO deve ser versionado — ele não está no .gitignore
# por padrão, então mantenha as credenciais fora do Git.
#
#   cp mysql-api.env.example mysql-api.env
#
# O ambiente do processo sempre tem prioridade sobre o arquivo (em Docker/
# Dokploy basta definir as variáveis no painel do serviço).
# ============================================================================
#
# ── Rodando no Dokploy (banco criado no painel) ─────────────────────────────
# Não use este arquivo lá: as variáveis vão na aba **Environment** do serviço
# Docker Compose. Pegue os valores em Dokploy → banco de dados → aba
# **Connection → Internal Credentials** e cole assim:
#
#   MYSQL_HOST=<Internal Host>   ex.: pingod-h2rdn7  (NÃO é o domínio público)
#   MYSQL_PORT=3306              porta INTERNA do container do banco
#   MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE  ← copie iguais
#
# O container `api` já entra na rede `dokploy-network` (veja docker-compose.yml),
# que é a mesma rede dos bancos do Dokploy — por isso o host interno resolve.
# ============================================================================

# ── Conexão com o MySQL ──────────────────────────────────────────────────────
# Host do banco. Use o IP/host do seu servidor MySQL (não "localhost" se o
# banco estiver em outra máquina ou container).
MYSQL_HOST=127.0.0.1

# Porta padrão do MySQL.
MYSQL_PORT=3306

# Usuário do banco. Recomendado criar um usuário exclusivo do app:
#   CREATE USER 'pingos'@'%' IDENTIFIED BY 'senha-forte';
#   GRANT ALL PRIVILEGES ON pingos.* TO 'pingos'@'%';
#   FLUSH PRIVILEGES;
MYSQL_USER=pingos

# Senha do usuário acima.
MYSQL_PASSWORD=troque-esta-senha

# Nome do banco. É criado automaticamente pelo seed se não existir.
MYSQL_DATABASE=pingos

# Conexões simultâneas no pool (10 é um bom valor para um help desk).
MYSQL_POOL_SIZE=10

# Use "true" se o MySQL exigir TLS (bancos gerenciados na nuvem).
MYSQL_SSL=false

# Aplica schema + papéis + (opcional) admin automaticamente ao subir a API.
# É idempotente. Deixe "false" para assumir o controle manual das migrações.
MYSQL_AUTO_MIGRATE=true

# ── Servidor da API ──────────────────────────────────────────────────────────
# Porta em que a API HTTP escuta. O frontend em desenvolvimento chama
# http://localhost:4000 (veja VITE_API_URL logo abaixo).
API_PORT=4000

# Origens liberadas no CORS, separadas por vírgula. Deixe vazio para refletir a
# origem da requisição (cômodo em desenvolvimento). Em produção, liste o
# domínio do app: https://pingos.suaempresa.com
CORS_ORIGIN=

# Tempo de validade da sessão (em dias) antes de exigir novo login.
SESSION_TTL_DAYS=30

# Limite do corpo JSON das requisições (o upload de imagem NÃO usa JSON).
JSON_BODY_LIMIT=2mb

# ── Imagens dos chamados (substitui o storage do Convex) ─────────────────────
# Pasta onde as imagens anexadas aos chamados são gravadas. Use um caminho
# absoluto em produção e monte um volume persistente nele.
UPLOAD_DIR=./uploads

# Tamanho máximo por imagem, em bytes (padrão: 15 MB).
UPLOAD_MAX_BYTES=15728640

# ── Backup e restauração (Configurações → Backup) ────────────────────────────
# Pasta onde os arquivos .json de backup são gravados. Em Docker o padrão é
# /data/backups (volume persistente — veja docker-compose.yml).
BACKUP_DIR=./backups

# Gera um backup de segurança automático antes de cada restauração.
# Deixe "true": a restauração sobrescreve todos os dados atuais.
BACKUP_SAFETY=true

# Tamanho máximo de um arquivo enviado para restauração, em bytes (256 MB).
BACKUP_MAX_BYTES=268435456

# ── Notificações (sino in-app, e-mail, Telegram, WhatsApp) ───────────────────
# Os canais são ligados/desligados no app (Configurações → Notificações); estas
# variáveis são os segredos e o contexto do servidor.

# URL pública do app — usada nos links das notificações.
SITE_URL=http://localhost:5173

# E-mail transacional pela Resend (https://resend.com). Sem a chave, o envio de
# e-mail falha e o motivo fica registrado na tabela `notifications`.
RESEND_API_KEY=
RESEND_FROM=PingOS <onboarding@resend.dev>

# Ponte do WhatsApp (Baileys). No Docker é o nome do serviço do compose;
# rodando local é o processo `bun run whatsapp` na porta 3001.
WHATSAPP_BRIDGE_URL=http://localhost:3001

# Tempo máximo de cada chamada externa de notificação, em ms.
NOTIFY_TIMEOUT_MS=10000

# De quanto em quanto tempo o servidor procura chamados parados (minutos).
# 0 desliga o agendador (o botão "verificar agora" continua funcionando).
INACTIVITY_INTERVAL_MINUTES=60

# ── Seed do primeiro administrador (opcional) ────────────────────────────────
# Se preenchidos, `bun run mysql:seed` — e também o boot da API no Docker —
# cria este administrador. Sem eles, crie o primeiro admin com
# POST /api/auth/setup enviando `bootstrapToken` (o valor de BOOTSTRAP_TOKEN;
# sem essa variável o servidor gera um token aleatório e imprime no log).
# A senha NÃO é alterada se o usuário já existir.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=uma-senha-com-8-ou-mais-caracteres
# ADMIN_NAME=Administrador
# BOOTSTRAP_TOKEN=segredo-longo-para-o-primeiro-acesso

# ── Rate limiting ────────────────────────────────────────────────────────────
# Limites por IP: login (10 falhas/15 min), setup (10/h), chamado público
# (5/h), upload (30/15 min) e leitura de O.S. por foto (20/h, chamada paga).
# `false` desliga todos — use apenas em teste local.
RATE_LIMIT_ENABLED=true

# ── Logs ─────────────────────────────────────────────────────────────────────
# Nível do pino: trace | debug | info | warn | error | fatal | silent.
# Cada requisição gera uma linha JSON com id, método, rota, status e latência
# (o Authorization vai redigido). `/api/health` não é registrado.
LOG_LEVEL=info

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Esta é lida pelo navegador, então precisa estar no arquivo de ambiente do
# Vite (o mesmo `.env.local` que já tem VITE_CONVEX_URL).
#
# No Docker/Dokploy deixe VITE_API_URL **vazio**: o nginx do container `app`
# serve o site e repassa `/api` e `/uploads` para o serviço `api` na MESMA
# origem (sem CORS e sem conteúdo misto).
# VITE_API_URL=http://localhost:4000
#
# Para apontar um módulo do app para o backend MySQL em vez do Convex, use o
# cliente de src/lib/mysql-api.ts (ver MYSQL.md → "Migrando o frontend").
